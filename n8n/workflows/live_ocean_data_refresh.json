  "notes": [
    {
      "id": "sticky-note-001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [140, 80],
      "parameters": {
        "width": 400,
        "height": 160,
        "content": "## Live Ocean Data Refresh\n\nThis workflow refreshes the latest Copernicus Marine (SST, chlorophyll, currents) and Argo float profile data every 6 hours. It calls the FastAPI backend's `/api/ocean/refresh` endpoint which fetches new data, processes it, and updates the local Parquet store."
      }
    },
    {
      "id": "sticky-note-002",
      "name": "Sticky Note1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [900, 640],
      "parameters": {
        "width": 380,
        "height": 120,
        "content": "## Error Handling\n\nError paths capture backend unavailability and refresh failures with timestamps for debugging. Connect these to notification nodes (Telegram/email) as needed."
      }
    },
    {
      "id": "sticky-note-003",
      "name": "Sticky Note2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1440, 60],
      "parameters": {
        "width": 420,
        "height": 120,
        "content": "## Architecture\n\nn8n → POST /api/ocean/refresh → FastAPI → copernicusmarine.open_dataset() + ArgoVis → Process → Update Parquet → Reload"
      }
    }
  ]
