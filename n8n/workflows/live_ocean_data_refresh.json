{
  "id": "r7kW3mPx9vLn2qYa",
  "meta": {
    "instanceId": "ocean-sentry-live-refresh"
  },
  "name": "Ocean Sentry — Live Ocean Data Refresh",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [],
  "nodes": [
    {
      "id": "schedule-trigger-001",
      "name": "Schedule — Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      }
    },
    {
      "id": "manual-trigger-002",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 500],
      "parameters": {}
    },
    {
      "id": "health-check-003",
      "name": "Backend Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 400],
      "parameters": {
        "url": "http://127.0.0.1:8000/api/health",
        "method": "GET",
        "options": {}
      }
    },
    {
      "id": "if-backend-004",
      "name": "Backend Available?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 400],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-backend",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "trigger-refresh-005",
      "name": "Trigger Data Refresh",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 300],
      "parameters": {
        "url": "http://127.0.0.1:8000/api/ocean/refresh",
        "method": "POST",
        "options": {
          "timeout": 300000
        }
      }
    },
    {
      "id": "if-refresh-006",
      "name": "Refresh Successful?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1240, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-refresh",
              "leftValue": "={{ $json.status }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "get-data-status-007",
      "name": "Get Data Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 200],
      "parameters": {
        "url": "http://127.0.0.1:8000/api/ocean/data-status",
        "method": "GET",
        "options": {}
      }
    },
    {
      "id": "refresh-report-008",
      "name": "Refresh Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 200],
      "parameters": {
        "jsCode": "const refreshData = $('Trigger Data Refresh').item.json;\nconst dataStatus = $('Get Data Status').item.json;\n\nreturn [{\n  json: {\n    refresh_status: 'completed',\n    copernicus_latest: refreshData.copernicus_latest || null,\n    argo_latest: refreshData.argo_latest || null,\n    records_refreshed: refreshData.records_refreshed || 0,\n    data_status: dataStatus,\n    timestamp: new Date().toISOString()\n  }\n}];"
      }
    },
    {
      "id": "error-backend-009",
      "name": "Error — Backend Unavailable",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [980, 540],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-error-type",
              "name": "error_type",
              "value": "backend_unavailable",
              "type": "string"
            },
            {
              "id": "assign-error-message",
              "name": "message",
              "value": "FastAPI backend at http://127.0.0.1:8000 is not responding. Ensure the Ocean Sentry backend is running.",
              "type": "string"
            },
            {
              "id": "assign-error-ts",
              "name": "timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "error-refresh-010",
      "name": "Error — Refresh Failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1500, 440],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-fail-type",
              "name": "error_type",
              "value": "refresh_failed",
              "type": "string"
            },
            {
              "id": "assign-fail-message",
              "name": "message",
              "value": "={{ 'Data refresh failed: ' + $json.error || $json.message || 'Unknown error' }}",
              "type": "string"
            },
            {
              "id": "assign-fail-status",
              "name": "response_status",
              "value": "={{ $json.status }}",
              "type": "string"
            },
            {
              "id": "assign-fail-ts",
              "name": "timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    }
  ],
