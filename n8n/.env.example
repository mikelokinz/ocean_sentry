# n8n Environment Configuration for Ocean Sentry

# Ocean Sentry Backend API (from inside Docker, use host.docker.internal)
OCEAN_SENTRY_API_URL=http://host.docker.internal:8000

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Google Gemini API Key (for voice transcription)
GEMINI_API_KEY=

# n8n Settings
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
